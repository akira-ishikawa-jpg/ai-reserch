OPENAI_API_KEY=your_openai_api_key_here

# ── Crypto Auto Trader ──────────────────────────────────────────────────────
# Exchange (binance, bybit, kraken, coinbase, okx, ...)
EXCHANGE=binance

# API credentials — required only for LIVE trading
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Trading pair and candle timeframe
TRADING_SYMBOL=BTC/USDT
TIMEFRAME=1h

# Paper trading (true = simulate, false = real money!)
PAPER_TRADING=true

# Starting virtual balance for paper trading (USDT)
INITIAL_BALANCE=10000

# Risk management
POSITION_SIZE_PCT=0.10    # 10% of balance per trade
STOP_LOSS_PCT=0.02        # 2% stop loss
TAKE_PROFIT_PCT=0.04      # 4% take profit
MAX_DRAWDOWN_PCT=0.20     # halt if total drawdown > 20%

# How often to check the market (seconds)
LOOP_INTERVAL_SEC=60
