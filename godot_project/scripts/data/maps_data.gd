extends RefCounted
class_name MapsData
## マップタイルデータ
## Web版 maps.js から移植

# ==========================================
# タイル定数
# ==========================================

const TILE_EMPTY: int = 0
const TILE_WALL: int = 1
const TILE_FLOOR: int = 2
const TILE_WATER: int = 3
const TILE_DOOR: int = 4
const TILE_CHEST: int = 5
const TILE_SAVE: int = 6
const TILE_NPC: int = 7
const TILE_ENTRANCE: int = 8

# ==========================================
# 通行判定
# ==========================================

static func is_passable(tile_type: int) -> bool:
	return tile_type in [TILE_EMPTY, TILE_FLOOR, TILE_DOOR, TILE_ENTRANCE, TILE_SAVE, TILE_CHEST, TILE_NPC]

# ==========================================
# マップ定義を返す
# ==========================================

static func get_map(map_id: String) -> Dictionary:
	match map_id:
		"kasumikari":
			return _kasumikari()
		"sennenZakura_entrance":
			return _sennenZakura_entrance()
		"sennenZakura_depths":
			return _sennenZakura_depths()
		_:
			push_error("Unknown map: " + map_id)
			return {}

